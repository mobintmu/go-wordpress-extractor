# Example production settings for the search engines, to copy into
# .env.production (which deploy.sh writes and git ignores). The server never
# reads this file. The other settings are documented in README.md
# ("Environment variables") and written by: sudo ./deploy.sh env
#
# The search engines serve sites whose config sets "fetch": {"engine": "brave"},
# "duckduckgo", "mojeek", "yahoo" or "yandex" (with "alternate_engines" for
# another one). They never contact the product's site: the product is built
# from the search result (title, url, description snippet) and every other
# field is listed in unavailable_fields. All are off by default. Before
# enabling one, read README.md "Responsible use": you call the provider under
# your own account and its terms, not this project's.
#
# Turn on with: sudo ./deploy.sh search enable brave|duckduckgo|mojeek|yahoo|yandex

# Honest client name sent to the providers. Do not put personal contact
# details here unless you mean to share them with the provider.
APP_SEARCH_USER_AGENT=go-wordpress-extractor/1.0
# How long a matched result, and a SEARCH_NO_RESULT answer, are kept in memory.
APP_SEARCH_CACHE_TTL=6h
APP_SEARCH_NO_RESULT_CACHE_TTL=1h

# DuckDuckGo: reads html.duckduckgo.com/html/ (allowed by its robots.txt).
# No key, no account, no SLA. DuckDuckGo has not approved this project.
APP_DUCKDUCKGO_ENABLED=false
# Minimum time between two DuckDuckGo queries from this instance.
APP_DUCKDUCKGO_MIN_INTERVAL_MS=2000

# Brave Search API: needs your own key from the Brave Search API dashboard.
APP_BRAVE_ENABLED=false
# Secret. Either the key itself...
APP_BRAVE_API_KEY=
# ...or a file that holds only the key (used when APP_BRAVE_API_KEY is empty).
APP_BRAVE_API_KEY_FILE=
# 1000 fits the free tier's 1 query per second; lower it on a larger plan.
APP_BRAVE_MIN_INTERVAL_MS=1000

# Mojeek, Yahoo and Yandex: the engine's HTML results page, read through
# github.com/jcalvert/metawebsearch (its request builders and parsers only).
# No key, no account, no SLA; none of the three has approved this project.
# Queries carry APP_SEARCH_USER_AGENT, never a browser's identity, and a
# block (HTTP 202/403/429) is reported and not retried. Each engine has its
# own switch so you can enable exactly the providers whose terms you accept.
APP_MOJEEK_ENABLED=false
APP_MOJEEK_MIN_INTERVAL_MS=3000
APP_YAHOO_ENABLED=false
APP_YAHOO_MIN_INTERVAL_MS=3000
APP_YANDEX_ENABLED=false
APP_YANDEX_MIN_INTERVAL_MS=3000

# ---------------------------------------------------------------------------
# AI crawler: engine "ai-crawler-avalai" (see md/AI_CRAWLER_AVALAI_PROPOSAL.md)
# ---------------------------------------------------------------------------
# Fetches the product page and extracts name, price, url, image, description,
# specs and features with an LLM over an OpenAI-compatible API (AvalAI by
# default). Every value is checked against the page before it is returned.
# Off by default. The page content of every AI-served URL is sent to the
# provider: read README.md "Responsible use" before enabling it.
APP_AI_CRAWLER_ENABLED=false
# Serve every host that has no file in configs/sites/ with the AI crawler.
# false: unknown hosts keep failing with SITE_NOT_CONFIGURED.
APP_AI_CRAWLER_DEFAULT_RULE=true

# OpenAI-compatible endpoint and model. Plain http is accepted for localhost only.
APP_AI_CRAWLER_BASE_URL=https://api.avalai.ir/v1
# The only model used; there is no fallback model.
APP_AI_CRAWLER_MODEL=deepseek-v4.1-flash
# Secret. Either the key itself (only in a git-ignored file such as .env or
# .env.production, or in the shell)...
APP_AI_CRAWLER_API_KEY=
# ...or a file that holds only the key (used when the key above is empty).
APP_AI_CRAWLER_API_KEY_FILE=secrets/avalai_api_key

# Limits
APP_AI_CRAWLER_TIMEOUT=45s
APP_AI_CRAWLER_MAX_INPUT_CHARS=60000
APP_AI_CRAWLER_MAX_OUTPUT_TOKENS=2000
APP_AI_CRAWLER_TEMPERATURE=0
# Retries of 408, 409, 429 and 5xx answers (Retry-After is honored).
APP_AI_CRAWLER_RETRIES=2
# Minimum gap between two LLM calls from this instance (provider RPM limit).
APP_AI_CRAWLER_MIN_INTERVAL_MS=500
# Same page and model within the TTL reuses the answer; 0 turns the cache off.
APP_AI_CRAWLER_CACHE_TTL=6h
# json_object works with every model; json_schema is stricter, test it first.
APP_AI_CRAWLER_RESPONSE_FORMAT=json_object
# Gap between two fetches of the same unknown host under the default rule.
APP_AI_CRAWLER_DEFAULT_DELAY_MS=2000

# Selector learning: an AI result teaches CSS selectors for the host; after
# PROMOTE_AFTER different product pages match in shadow they serve the host
# without LLM calls. Review with: go run ./cmd/sitectl learned list
APP_AI_CRAWLER_LEARN_SELECTORS=true
# Default <APP_SITE_CONFIG_DIR>/learned. Must be writable (Docker: a volume).
APP_AI_CRAWLER_LEARN_DIR=
APP_AI_CRAWLER_LEARN_PROMOTE_AFTER=3
APP_AI_CRAWLER_LEARN_DEMOTE_AFTER=3
APP_AI_CRAWLER_LEARN_MAX_ATTEMPTS_PER_DAY=3
