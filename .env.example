# Example production settings for the search engines, to copy into
# .env.production (which deploy.sh writes and git ignores). The server never
# reads this file. The other settings are documented in README.md
# ("Environment variables") and written by: sudo ./deploy.sh env
#
# The search engines serve sites whose config sets "fetch": {"engine": "brave"}
# or "duckduckgo" (with "alternate_engines" for the other one). They never
# contact the product's site: the product is built from the search result
# (title, url, description snippet) and every other field is listed in
# unavailable_fields. Both are off by default. Before enabling one, read
# README.md "Responsible use": you call the provider under your own account
# and its terms, not this project's.
#
# Turn on with: sudo ./deploy.sh search enable brave|duckduckgo

# Honest client name sent to the providers. Do not put personal contact
# details here unless you mean to share them with the provider.
APP_SEARCH_USER_AGENT=go-wordpress-extractor/1.0
# How long a matched result, and a SEARCH_NO_RESULT answer, are kept in memory.
APP_SEARCH_CACHE_TTL=6h
APP_SEARCH_NO_RESULT_CACHE_TTL=1h

# DuckDuckGo: reads html.duckduckgo.com/html/ (allowed by its robots.txt).
# No key, no account, no SLA. DuckDuckGo has not approved this project.
APP_DUCKDUCKGO_ENABLED=false
# Minimum time between two DuckDuckGo queries from this instance.
APP_DUCKDUCKGO_MIN_INTERVAL_MS=2000

# Brave Search API: needs your own key from the Brave Search API dashboard.
APP_BRAVE_ENABLED=false
# Secret. Either the key itself...
APP_BRAVE_API_KEY=
# ...or a file that holds only the key (used when APP_BRAVE_API_KEY is empty).
APP_BRAVE_API_KEY_FILE=
# 1000 fits the free tier's 1 query per second; lower it on a larger plan.
APP_BRAVE_MIN_INTERVAL_MS=1000
