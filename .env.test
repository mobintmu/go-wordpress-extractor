APP_ENV=test
APP_HTTP_PORT=4001
APP_HTTP_ADDRESS=127.0.0.1
APP_SITE_CONFIG_DIR=configs
APP_API_KEYS_FILE=secrets/api_keys.test.json
APP_API_KEY_PEPPER=test-pepper-not-for-production-0123456789abcdef
APP_MAX_REQUEST_DURATION=3m
APP_SITE_WAIT_TIMEOUT=30s
APP_MAX_CONCURRENT_REQUESTS=20
APP_MAX_CONCURRENT_PER_SITE=1
# Search engines stay off in tests: unit tests use fake providers and never
# send real queries (opt-in live test: SEARCH_LIVE_TEST=1).
APP_DUCKDUCKGO_ENABLED=false
APP_BRAVE_ENABLED=false
APP_MOJEEK_ENABLED=false
APP_YAHOO_ENABLED=false
APP_YANDEX_ENABLED=false
# The AI crawler stays off in tests: e2e tests turn it on per test against a
# fake OpenAI-compatible server and never call AvalAI.
APP_AI_CRAWLER_ENABLED=false
