# Server
APP_ENV=development
APP_HTTP_PORT=4000
APP_HTTP_ADDRESS=127.0.0.1

# Site configs and API keys
APP_SITE_CONFIG_DIR=configs
APP_API_KEYS_FILE=secrets/api_keys.json
# Development pepper only. Production uses its own secret from the environment.
APP_API_KEY_PEPPER=-OyRonjb0wYVpPueRdE1qmzLJmUtuapszo7UoL28k4s

# Operator credentials for Swagger UI and /metrics.
# Create the hash with: echo -n 'password' | go run ./cmd/apikey hash-ops-password
APP_OPS_USER=admin
APP_OPS_PASSWORD_HASH=kgK6wSmp2w77xKXXwwWP_WPKz9VesUEQtHT9KRXmGvM

# Limits
APP_MAX_REQUEST_DURATION=3m
APP_SITE_WAIT_TIMEOUT=30s
APP_MAX_CONCURRENT_REQUESTS=20
APP_MAX_CONCURRENT_PER_SITE=1

# Outbound HTTP proxy for page fetches. Leave both empty to fetch directly.
APP_PROXY_HOST=
APP_PROXY_PORT=

# Browser fetch engine (sites with "fetch": {"engine": "browser"}, e.g. hafele).
# Hafele's Cloudflare challenge only passes with real Google Chrome in a window
# (headless Chromium stays on "Just a moment..."), so this needs a display
# (a desktop session, or Xvfb on a server).
APP_BROWSER_ENABLED=true
APP_BROWSER_CHANNEL=chrome
APP_BROWSER_HEADLESS=false
