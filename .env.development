# Server
APP_ENV=development
APP_HTTP_PORT=80
APP_HTTP_ADDRESS=127.0.0.1

# Site configs and API keys
APP_SITE_CONFIG_DIR=configs
APP_API_KEYS_FILE=secrets/api_keys.json
# Development pepper only. Production uses its own secret from the environment.
APP_API_KEY_PEPPER=1KnVog0bauGtDSAlSMeP7JlyySrARaBwEd7hEzcmjrM

# Operator credentials for Swagger UI and /metrics.
# Create the hash with: echo -n 'password' | go run ./cmd/apikey hash-ops-password
APP_OPS_USER=admin
APP_OPS_PASSWORD_HASH=KaL74pJQfG0U7VzUpoVej6BxfFo9fTNTNUJKMmlBhF8

# Limits
APP_MAX_REQUEST_DURATION=3m
APP_SITE_WAIT_TIMEOUT=30s
APP_MAX_CONCURRENT_REQUESTS=20
APP_MAX_CONCURRENT_PER_SITE=1

# Outbound HTTP proxy for page fetches. Leave both empty to fetch directly.
APP_PROXY_HOST=
APP_PROXY_PORT=

# Browser fetch engine (sites with "fetch": {"engine": "browser"}), for pages
# rendered by JavaScript. Some sites only load in real Google Chrome in a window
# (headless Chromium stays on "Just a moment..."), so this needs a display
# (a desktop session, or Xvfb on a server).
APP_BROWSER_ENABLED=true
APP_BROWSER_CHANNEL=chrome
APP_BROWSER_HEADLESS=false

# Search engines (sites with "fetch": {"engine": "brave"}, "duckduckgo",
# "mojeek", "yahoo" or "yandex", e.g. fergusonhome.com and lumens.com). They
# never contact the product's site. See README "Search engines" and
# "Responsible use", and md/ENGINES.md.
APP_SEARCH_USER_AGENT=go-wordpress-extractor/1.0
APP_SEARCH_CACHE_TTL=6h
APP_SEARCH_NO_RESULT_CACHE_TTL=1h
# DuckDuckGo needs no key.
APP_DUCKDUCKGO_ENABLED=true
APP_DUCKDUCKGO_MIN_INTERVAL_MS=2000
# Brave needs an API key. THIS FILE IS COMMITTED: never put the key here.
# Put the key alone in secrets/brave_api_key (secrets/ is git-ignored), or
# export APP_BRAVE_API_KEY in your shell, then set APP_BRAVE_ENABLED=true.
APP_BRAVE_ENABLED=false
APP_BRAVE_API_KEY_FILE=secrets/brave_api_key
APP_BRAVE_MIN_INTERVAL_MS=1000
# Mojeek, Yahoo and Yandex need no key (results pages through metawebsearch).
# Off until a site config uses one; turn on the engine whose terms you accept.
APP_MOJEEK_ENABLED=false
APP_MOJEEK_MIN_INTERVAL_MS=3000
APP_YAHOO_ENABLED=false
APP_YAHOO_MIN_INTERVAL_MS=3000
APP_YANDEX_ENABLED=false
APP_YANDEX_MIN_INTERVAL_MS=3000

# AI crawler (engine ai-crawler-avalai): LLM extraction over AvalAI's
# OpenAI-compatible API; the default engine below serves hosts without a rule.
# THIS FILE IS COMMITTED: never put the key here. The key is alone in
# secrets/avalai_api_key (secrets/ is git-ignored), or export
# APP_AI_CRAWLER_API_KEY in your shell.
APP_AI_CRAWLER_ENABLED=true
APP_AI_CRAWLER_BASE_URL=https://api.avalai.ir/v1
APP_AI_CRAWLER_MODEL=deepseek-v4.1-flash
# AvalAI model that searches the web itself, for sites whose config sets
# fetch.ai_fetch "web_search" (the site is never contacted). none: off.
APP_AI_CRAWLER_SEARCH_MODEL=sonar
APP_AI_CRAWLER_API_KEY_FILE=secrets/avalai_api_key
APP_AI_CRAWLER_CACHE_TTL=6h
APP_AI_CRAWLER_LEARN_SELECTORS=true

# Engine for any website that has no rule of its own (no site config and
# no active learned config): ai-crawler-avalai (default),
# ai-crawler-cloudflare, or none (fails with SITE_NOT_CONFIGURED).
# It replaced APP_AI_CRAWLER_DEFAULT_RULE (true = ai-crawler-avalai,
# false = none): the server refuses to start while that is still set.
APP_DEFAULT_ENGINE=ai-crawler-avalai

# AI crawler (engine ai-crawler-cloudflare, Cloudflare AI Gateway).
# Not configured until the account id is set. The token is alone in
# secrets/cloudflare_api_token (git-ignored), never in this file.
APP_AI_CRAWLER_CLOUDFLARE_ACCOUNT_ID=
APP_AI_CRAWLER_CLOUDFLARE_GATEWAY_ID=default
APP_AI_CRAWLER_CLOUDFLARE_ENDPOINT=rest
APP_AI_CRAWLER_CLOUDFLARE_MODEL=@cf/deepseek-ai/deepseek-v4.1-flash-1017
APP_AI_CRAWLER_CLOUDFLARE_REASONING_EFFORT=none
APP_AI_CRAWLER_CLOUDFLARE_API_TOKEN_FILE=secrets/cloudflare_api_token
APP_AI_CRAWLER_CLOUDFLARE_NO_UNIFIED_BILLING=true
APP_AI_CRAWLER_CLOUDFLARE_COLLECT_LOG=false
