# Server
APP_ENV=development
APP_HTTP_PORT=4000
APP_HTTP_ADDRESS=127.0.0.1

# Site configs and API keys
APP_SITE_CONFIG_DIR=configs
APP_API_KEYS_FILE=secrets/api_keys.json
# Development pepper only. Production uses its own secret from the environment.
APP_API_KEY_PEPPER=1KnVog0bauGtDSAlSMeP7JlyySrARaBwEd7hEzcmjrM

# Operator credentials for Swagger UI and /metrics.
# Create the hash with: echo -n 'password' | go run ./cmd/apikey hash-ops-password
APP_OPS_USER=admin
APP_OPS_PASSWORD_HASH=KaL74pJQfG0U7VzUpoVej6BxfFo9fTNTNUJKMmlBhF8

# Limits
APP_MAX_REQUEST_DURATION=3m
APP_SITE_WAIT_TIMEOUT=30s
APP_MAX_CONCURRENT_REQUESTS=20
APP_MAX_CONCURRENT_PER_SITE=1

# Outbound HTTP proxy for page fetches. Leave both empty to fetch directly.
APP_PROXY_HOST=
APP_PROXY_PORT=

# Browser fetch engine (sites with "fetch": {"engine": "browser"}), for pages
# rendered by JavaScript. Some sites only load in real Google Chrome in a window
# (headless Chromium stays on "Just a moment..."), so this needs a display
# (a desktop session, or Xvfb on a server).
APP_BROWSER_ENABLED=true
APP_BROWSER_CHANNEL=chrome
APP_BROWSER_HEADLESS=false

# Search engines (sites with "fetch": {"engine": "brave"} or "duckduckgo", e.g.
# fergusonhome.com and hafele.com.de). They never contact the product's site.
# See README "Search engines" and "Responsible use".
APP_SEARCH_USER_AGENT=go-wordpress-extractor/1.0
APP_SEARCH_CACHE_TTL=6h
APP_SEARCH_NO_RESULT_CACHE_TTL=1h
# DuckDuckGo needs no key.
APP_DUCKDUCKGO_ENABLED=true
APP_DUCKDUCKGO_MIN_INTERVAL_MS=2000
# Brave needs an API key. THIS FILE IS COMMITTED: never put the key here.
# Put the key alone in secrets/brave_api_key (secrets/ is git-ignored), or
# export APP_BRAVE_API_KEY in your shell, then set APP_BRAVE_ENABLED=true.
APP_BRAVE_ENABLED=false
APP_BRAVE_API_KEY_FILE=secrets/brave_api_key
APP_BRAVE_MIN_INTERVAL_MS=1000
